{
  "name": "recueil-de-couleur",
  "version": "0.11.0",
  "description": "Liste de noms de couleur en français.",
  "type": "module",
  "main": "colors.json",
  "exports": {
    ".": "./colors.json",
    "./colors.json": "./colors.json",
    "./colors.min.json": "./colors.min.json",
    "./colors.csv": "./colors.csv",
    "./package.json": "./package.json"
